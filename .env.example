# Leave unset to run the device-local, clearly labeled demo.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Required for the protected rider reassignment cron endpoint on Vercel.
CRON_SECRET=
# Server only. Never prefix this variable with NEXT_PUBLIC_. Used by dispatch and shared search quotas.
SUPABASE_SERVICE_ROLE_KEY=
# Optional server-only Photon provider. Leave empty for the public pilot service.
PHOTON_BASE_URL=
# Optional public Turnstile site key. Also enable CAPTCHA in Supabase Auth with the matching secret.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
